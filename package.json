{
  "name": "@meri-imperiumi/signalk-internet",
  "version": "0.7.0",
  "description": "Centralized internet connectivity state detection for Signal K",
  "main": "index.js",
  "scripts": {
    "format": "npx @biomejs/biome check --use-editorconfig=true --write index.js lib/ test/ public/",
    "lint": "npx @biomejs/biome check --use-editorconfig=true index.js lib/ public/",
    "test": "node --test --test-force-exit \"test/*.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/meri-imperiumi/signalk-internet.git"
  },
  "bugs": {
    "url": "https://github.com/meri-imperiumi/signalk-internet/issues"
  },
  "homepage": "https://github.com/meri-imperiumi/signalk-internet#readme",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-utility",
    "signalk-webapp"
  ],
  "author": "Henri Bergius <henri.bergius@iki.fi>",
  "license": "EUPL-1.2",
  "signalk-plugin-enabled-by-default": true,
  "signalk": {
    "displayName": "Internet Connectivity Monitor",
    "appIcon": "./icon-256.png",
    "screenshots": [
      "doc/internet.png"
    ],
    "recommends": [
      "signalk-starlink",
      "signalk-starlink-offshore",
      "@meri-imperiumi/signalk-teltonika-rutx11"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@signalk/server-api": "^2.30.0"
  }
}
